# Database
DATABASE_URL=postgresql://kb:kb@localhost:5432/kb

# Team: HEAD PC that `kb sync` pulls snapshots from (already the built-in default; change if it moves)
# KB_HEAD_URL=http://10.30.0.60:3001

# LLM provider: ollama | openai
LLM_PROVIDER=ollama

# --- Ollama (local) ---
# Comma-separated host list, tried in order. Add a local Ollama as fallback for when the remote is down:
#   OLLAMA_BASE_URL=http://10.30.0.60:11434,http://localhost:11434
# (install: brew install ollama && brew services start ollama && ollama pull nomic-embed-text)
OLLAMA_BASE_URL=http://10.30.0.60:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5-coder:7b
EMBEDDING_DIMENSIONS=768

# --- OpenAI (cloud, alternative) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o-mini
# EMBEDDING_DIMENSIONS=1536

# API server
API_PORT=3001
API_HOST=0.0.0.0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

NODE_ENV=development
